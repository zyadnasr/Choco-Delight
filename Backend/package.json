{
  "name": "choco-delight-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "set NODE_ENV=test&& node --import tsx --test src/server.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.30",
    "prisma": "6.14.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
